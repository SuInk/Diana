[
  {
    "id": "host_exec",
    "label": "本机代码执行",
    "impact": "本机命令（run_command）和编码代理停用，浏览器里也不能执行脚本",
    "rules": [
      {
        "category": "host_exec",
        "tool": "run_command",
        "reason": "在本机执行命令"
      },
      {
        "category": "host_exec",
        "tool": "coding",
        "reason": "编码代理在仓库里不受白名单约束地跑命令、改代码"
      },
      {
        "category": "host_exec",
        "tool": "browser_eval",
        "reason": "在带登录态的页面里执行任意 JavaScript"
      }
    ]
  },
  {
    "id": "third_party",
    "label": "安装和运行第三方代码",
    "impact": "不能安装、卸载或启用 Skill 和 MCP；已启用的 MCP 工具不可用（Skill 说明文档仍可读取）",
    "rules": [
      {
        "category": "third_party",
        "tool": "install_skill",
        "reason": "从外部来源安装 Skill"
      },
      {
        "category": "third_party",
        "tool": "uninstall_skill",
        "reason": "卸载 Skill 属于扩展管理，和安装同一档"
      },
      {
        "category": "third_party",
        "tool": "mcp_install",
        "reason": "安装 MCP 服务就是在本机装一个第三方程序"
      },
      {
        "category": "third_party",
        "tool": "mcp_uninstall",
        "reason": "MCP 服务管理，和安装同一档"
      },
      {
        "category": "third_party",
        "tool": "mcp_set_enabled",
        "reason": "启用 MCP 服务等于让第三方程序开始跑"
      },
      {
        "category": "third_party",
        "tool": "mcp__*",
        "reason": "MCP 服务是第三方程序，以机器人的权限运行，已启用的也不给用"
      }
    ]
  },
