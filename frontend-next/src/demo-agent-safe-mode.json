  {
    "id": "file_write",
    "label": "改动本地文件",
    "impact": "不能再写入、编辑、保存或整理工作区文件（列目录、读取、检索、发送附件照常）",
    "rules": [
      {
        "category": "file_write",
        "tool": "write_file",
        "reason": "写入工作区文件"
      },
      {
        "category": "file_write",
        "tool": "edit_file",
        "reason": "修改工作区文件"
      },
      {
        "category": "file_write",
        "tool": "save_to_workspace",
        "reason": "把文件存进工作区"
      },
      {
        "category": "file_write",
        "tool": "manage_files",
        "field": "action",
        "operations": [
          "move",
          "copy",
          "delete",
          "mkdir"
        ],
        "reason": "挪动、复制、删除文件或建目录；stat 照常"
      }
    ]
  },
  {
    "id": "self_modify",
    "label": "改机器人设置和群管",
    "impact": "不能改机器人配置、回复屏蔽名单、机器人标记、模型设置和扩展权限，不能禁言、踢人或处理好友和加群请求",
    "rules": [
      {
        "category": "self_modify",
        "tool": "bot_config",
        "field": "operation",
        "operations": [
          "update"
        ],
        "reason": "修改机器人的接话和闲聊设置；读取照常"
      },
      {
        "category": "self_modify",
        "tool": "reply_block",
        "field": "operation",
        "operations": [
          "block",
          "unblock"
        ],
        "reason": "修改回复屏蔽名单；查看照常"
      },
      {
        "category": "self_modify",
        "tool": "bot_markers",
        "field": "operation",
        "operations": [
          "mark",
          "unmark"
        ],
        "reason": "修改机器人标记名单；查看照常"
      },
      {
        "category": "self_modify",
        "tool": "llm_config",
        "field": "operation",
