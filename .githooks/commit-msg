#!/bin/sh
# 启用：git config core.hooksPath .githooks
msg_file="$1"

# 一、去掉 AI 工具自动加的署名：Co-Authored-By: Claude … / Claude-Session … / Generated with Claude Code
pattern='^[Cc]o-[Aa]uthored-[Bb]y:.*([Cc]laude|anthropic\.com)|^[Cc]laude-[Ss]ession:|Generated with \[?Claude Code'
if grep -qE "$pattern" "$msg_file"; then
  tmp="$msg_file.tmp.$$"
  # 删掉署名行，再去掉末尾因此多出来的空行
  grep -vE "$pattern" "$msg_file" | awk '{ lines[NR] = $0 } END { n = NR; while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print lines[i] }' > "$tmp"
  mv "$tmp" "$msg_file"
  echo "commit-msg: 已去掉 Claude 署名" >&2
fi

# 二、正文得有一段说明。Release 正文每条改动下面那行「为什么改」取的就是这一段，
# 没有它到发版那天才看得出来。CI 里卡的是 PR 正文（squash 后落到 main 的是它），
# 这里只是让人在本地就发现，规则保持一致。
subject=$(sed -n '1p' "$msg_file")
case "$subject" in
  'chore(release)'*|Merge\ *|Revert\ *|fixup!*|squash!*|amend!*) exit 0 ;;
esac

# 标题、要点、引用、代码块和 git 自己加的注释都不算说明；剩下的第一行要够长。
paragraph=$(
  sed -e '1d' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$msg_file" |
    awk '/^```/ { fence = !fence; next } !fence' |
    grep -vE '^([-*+>|#]|[0-9]+\.|$)' |
    awk '{ if (length($0) >= 20) { print; exit } }'
)
if [ -z "$paragraph" ]; then
  echo "commit-msg: 正文缺少说明段落。标题下面空一行，写一段为什么改——" >&2
  echo "            要点清单不算，至少 20 个字。实在不想写：git commit --no-verify" >&2
  exit 1
fi
