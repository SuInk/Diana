# Copy to .env for Docker Compose or runtime.env for the macOS launcher.
# Never commit the populated file.

# HTTP server and local state.
HOST=127.0.0.1
DIANA_BIND_ADDRESS=127.0.0.1
PORT=18080
APP_DB_PATH=data/diana.db
LOG_PATH=logs/diana.log
FRONTEND_DIST=frontend-next/dist

# WebUI authentication. Leave both empty to generate a diana# account and a
# strong password on first startup. The generated credentials are printed once.
DIANA_ADMIN_USERNAME=
DIANA_ADMIN_PASSWORD=

# Source checkout used by WebUI OTA updates.
DIANA_UPDATE_ROOT=.
DIANA_UPDATE_APPLY_ENABLED=true
DIANA_RELEASE_UPDATE_ENABLED=true

# NapCat WebUI and local launcher integration (optional).
DIANA_NAPCAT_WEBUI_URL=
DIANA_NAPCAT_WEBUI_TOKEN=
DIANA_NAPCAT_QRCODE_PATH=
DIANA_START_NAPCAT=true
DIANA_QQ_APP=/Applications/QQ.app
NAPCAT_QQ=

# OneBot / QQ identity.
QQBOT_ENABLED=false
QQBOT_QQ=
DIANA_OWNER_ID=
DIANA_GROUP_TRIGGERS=Diana,diana
ONEBOT_REVERSE_WS_ENDPOINT=ws://127.0.0.1:18080/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=

# Optional NoneBot bridge.
NONEBOT_BRIDGE_ENABLED=false
NONEBOT_BRIDGE_ENDPOINT=ws://127.0.0.1:8080/onebot/v11/ws
NONEBOT_BRIDGE_TOKEN=

# Restored conversation, recall, prompt, and delivery behavior.
DIANA_SYSTEM_PROMPT=
DIANA_PROACTIVE_REPLY_ROUTER_PROMPT=
DIANA_PROACTIVE_REPLY_PROMPT=
DIANA_PROACTIVE_REPLY_CHANCE=1
DIANA_PROACTIVE_REPLY_THRESHOLD=0.9
DIANA_RECALL_REPLY_MODE=llm_summary
DIANA_LLM_QQ_ID_MASKING_ENABLED=true
DIANA_RECENT_GROUP_CONTEXT_LIMIT=24
DIANA_CONTEXT_SUMMARY_THRESHOLD=80
DIANA_MAX_INPUT_CHARS=2000
DIANA_MAX_REPLY_CHARS=3500
DIANA_DIRECT_REPLY_CHUNK_SIZE=900
DIANA_FORWARD_REPLY_THRESHOLD=900
DIANA_SEND_RETRY_ATTEMPTS=3
DIANA_SEND_CHUNK_INTERVAL_MS=300
DIANA_MAX_BOT_CONCURRENCY=8
DIANA_HTTP_TIMEOUT_SECONDS=180

# LLM provider. These values can also be managed in the WebUI.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_FORMAT=responses
LLM_MODEL=gpt-4o-mini
LLM_IMAGE_MODEL=
LLM_IMAGE_BASE_URL=
LLM_IMAGE_ORIGIN=
LLM_IMAGE_TIMEOUT_MS=
LLM_USER_AGENT=codex-cli/0.142.0
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=
LLM_TIMEOUT_MS=60000
LLM_CONTEXT_WINDOW_TOKENS=16384
LLM_MAX_CONTEXT_TOKENS=16384
LLM_MAX_OUTPUT_TOKENS=1024

# Agent tools. Installed plugins remain usable even when the full local Agent
# is disabled; enable this for shell, filesystem, browser, skills, and MCP.
DIANA_AGENT_ENABLED=true
DIANA_AGENT_WORK_DIR=.
DIANA_AGENT_SKILL_ROOTS=skills
DIANA_AGENT_MCP_CONFIG=.mcp.json
DIANA_AGENT_COMMAND_ALLOWLIST=
DIANA_AGENT_COMMAND_TIMEOUT_MS=30000
DIANA_AGENT_BROWSER_CDP_URL=
DIANA_AGENT_BROWSER_TIMEOUT_MS=30000

# Media sharing, document OCR, and social resolver limits.
DIANA_LOCAL_MEDIA_BASE_URL=
DIANA_MEDIA_DIR=
DIANA_MEDIA_MAX_MB=10
DIANA_MEDIA_CACHE_MB=512
DIANA_HISTORY_MEDIA_DIR=
DIANA_ALLOW_PRIVATE_HTTP_FETCHES=false
DIANA_RESOLVER_PROXY=
DIANA_RESOLVER_IMAGE_MAX_MB=25
DIANA_RESOLVER_VIDEO_MAX_MB=200
DIANA_RESOLVER_VIDEO_MAX_DURATION=900
DIANA_BILI_SESSDATA=
DIANA_DOUYIN_CK=
DIANA_XHS_CK=
DIANA_YTDLP_COOKIES=
DIANA_YTDLP_COOKIES_FROM_BROWSER=
DIANA_TWITTER_RESOLVER_API=
DIANA_TWITTER_METADATA_API=
DIANA_TWITTER_MIN_GROUP_LEVEL=40
DIANA_OCR_MAX_PAGES_PER_FILE=48
DIANA_OCR_RENDER_CONCURRENCY=3
DIANA_OCR_CONCURRENCY=3
DIANA_OCR_RENDER_DPI=180
DIANA_OCR_JPEG_QUALITY=82

# Optional GPT-SoVITS voice.
DIANA_TTS_VOICE_NAME=custom
DIANA_TTS_ENDPOINT=http://127.0.0.1:9880/tts
DIANA_TTS_API_KEY=
DIANA_TTS_REF_AUDIO_PATH=
DIANA_TTS_PROMPT_TEXT=
DIANA_TTS_TEXT_LANG=zh
DIANA_TTS_PROMPT_LANG=zh
DIANA_TTS_SPEED_FACTOR=1.0
DIANA_TTS_FFMPEG_PATH=ffmpeg
DIANA_TTS_SILK_ENCODER_PATH=
